// Fabric Rules reference queries — pair each with delivery actions

// Stockout detected: immediate alert
stockout_detected
| where ingest_timestamp > ago(5m)
| project store_id, dc_id, product_id, last_known_quantity, detection_time, trace_id

// Reorder URGENT
reorder_triggered
| where priority == 'URGENT' and ingest_timestamp > ago(10m)
| project store_id, dc_id, product_id, reorder_quantity, reorder_point, current_quantity, trace_id

// Truck dwell breach: completed lifecycle exceeds the 90-minute SLA
let threshold_minutes = 90.0;
fn_truck_sla()
| where departure_ingest_timestamp > ago(5m)
| where departure_ingest_timestamp <= now()
| where departure_time <= now()
| where dwell_minutes > threshold_minutes
| project truck_id, dc_id, store_id, shipment_id, site,
          arrival_time, departure_time, dwell_minutes, threshold_minutes

// Zone arrival surge or long expected dwell: this is not an occupancy estimate.
customer_entered
| where ingest_timestamp > ago(5m)
| summarize arrivals = sum(customer_count),
            dwell_seconds_weighted =
                sum(todouble(dwell_time) * todouble(customer_count))
    by store_id, zone
| extend avg_arrival_dwell_seconds = iif(
             arrivals == 0,
             real(null),
             dwell_seconds_weighted / todouble(arrivals)
         )
| where arrivals > 50 or avg_arrival_dwell_seconds > 600
| project store_id, zone, arrivals, avg_arrival_dwell_seconds

// High-value receipt: total above 3 x the store type's average ticket
// (calibration.HIGH_VALUE_TICKET_MULTIPLE x profile.avg_ticket_target).
// 255.0 is the supercenter value (3 x $85); set it for the deployed store type.
receipt_created
| where ingest_timestamp > ago(5m)
| where total > 255.0
| project store_id, receipt_id, total, trace_id

// Late truck: arrived 30+ minutes after its planned arrival
// (calibration.TRUCK_LATE_MINUTES), with the cause.
truck_arrived
| where ingest_timestamp > ago(5m)
| where delay_minutes >= 30
| project truck_id, dc_id, store_id, shipment_id, planned_arrival_time,
          arrival_time, delay_minutes, delay_reason, trace_id

// Lane delay over threshold: a DC-to-store lane whose trucks ran on average
// 60+ minutes late in the last hour because of a lane incident or severe
// weather (calibration.LANE_DELAY_RULE_MINUTES), one alert per lane. Traffic
// alone raises only the late-truck alert.
truck_arrived
| where ingest_timestamp > ago(60m)
| where delay_reason in ('LANE_DELAY', 'WEATHER')
| summarize trucks = dcount(shipment_id),
            avg_delay_minutes = avg(todouble(delay_minutes)),
            max_delay_minutes = max(delay_minutes),
            delay_reason = take_any(delay_reason)
    by dc_id, store_id
| where avg_delay_minutes >= 60.0
| project dc_id, store_id, trucks, avg_delay_minutes, max_delay_minutes, delay_reason

// DC outage started: a DC stopped dispatching; every store it serves is affected.
logistics_incident_started
| where ingest_timestamp > ago(5m)
| where incident_type == 'DC_OUTAGE'
| summarize arg_min(started_at, *) by incident_id
| project incident_id, dc_id, started_at, severity, affected_store_count,
          affected_store_ids, description

// Incident stockouts: 3+ distinct stockouts in the last hour at stores an
// open incident affects (calibration.INCIDENT_STOCKOUT_RULE_MIN_STOCKOUTS),
// one alert per incident.
let open_incidents = logistics_incident_started
    | summarize arg_min(started_at, *) by incident_id
    | join kind=leftanti logistics_incident_resolved on incident_id
    | mv-expand affected_store_id = affected_store_ids to typeof(long)
    | project incident_id, incident_type, dc_id, store_id = affected_store_id,
              started_at, description;
stockout_detected
| where ingest_timestamp > ago(60m)
| summarize arg_min(detection_time, *) by trace_id
| where isnotnull(store_id)
| join kind=inner open_incidents on store_id
| where detection_time >= started_at
| summarize stockouts = dcount(trace_id), stores = dcount(store_id),
            products = dcount(product_id), first_stockout = min(detection_time)
    by incident_id, incident_type, dc_id, description
| where stockouts >= 3
| project incident_id, incident_type, dc_id, stockouts, stores, products,
          first_stockout, description
