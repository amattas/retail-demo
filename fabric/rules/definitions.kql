// Fabric Rules reference queries — pair each with delivery actions

// Stockout detected: immediate alert
stockout_detected
| where ingest_timestamp > ago(5m)
| project store_id, dc_id, product_id, last_known_quantity, detection_time, trace_id

// Reorder URGENT
reorder_triggered
| where priority == 'URGENT' and ingest_timestamp > ago(10m)
| project store_id, dc_id, product_id, reorder_quantity, reorder_point, current_quantity, trace_id

// Truck dwell breach: completed lifecycle exceeds the 90-minute SLA
let threshold_minutes = 90.0;
fn_truck_sla()
| where departure_ingest_timestamp > ago(5m)
| where departure_ingest_timestamp <= now()
| where departure_time <= now()
| where dwell_minutes > threshold_minutes
| project truck_id, dc_id, store_id, shipment_id, site,
          arrival_time, departure_time, dwell_minutes, threshold_minutes

// Zone arrival surge or long expected dwell: this is not an occupancy estimate.
customer_entered
| where ingest_timestamp > ago(5m)
| summarize arrivals = sum(customer_count),
            dwell_seconds_weighted =
                sum(todouble(dwell_time) * todouble(customer_count))
    by store_id, zone
| extend avg_arrival_dwell_seconds = iif(
             arrivals == 0,
             real(null),
             dwell_seconds_weighted / todouble(arrivals)
         )
| where arrivals > 50 or avg_arrival_dwell_seconds > 600
| project store_id, zone, arrivals, avg_arrival_dwell_seconds

// High-value receipt: threshold on total
receipt_created
| where ingest_timestamp > ago(5m)
| where total > 200.0
| project store_id, receipt_id, total, trace_id
