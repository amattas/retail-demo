let window = 30m;
mv_zone_dwell_minute
| where ts > ago(window)
| summarize arrivals = sum(customers),
            dwell_seconds_weighted = sum(todouble(avg_dwell) * todouble(customers))
    by store_id, zone
| extend avg_dwell_seconds = iif(
             arrivals == 0,
             real(null),
             dwell_seconds_weighted / todouble(arrivals)
         )
| project store_id, zone, arrivals, avg_dwell_seconds
| order by arrivals desc
