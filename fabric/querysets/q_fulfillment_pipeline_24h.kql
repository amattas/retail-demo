// Staged fulfillment of the online orders created in the last 24h: how many of
// them have been picked, shipped (BOPIS orders never ship) and delivered or
// collected so far. Each stage follows the previous one by hours or days, and
// cancelled orders never move past created.
let window = 24h;
let created = online_order_created
    | where ingest_timestamp > ago(window)
    | distinct order_id;
let created_count = toscalar(created | count);
let picked_count = toscalar(
    online_order_picked
    | where order_id in (created)
    | summarize dcount(order_id)
);
let shipped_count = toscalar(
    online_order_shipped
    | where order_id in (created)
    | summarize dcount(order_id)
);
let delivered_count = toscalar(
    online_order_delivered
    | where order_id in (created)
    | summarize dcount(order_id)
);
print created = created_count, picked = picked_count, shipped = shipped_count,
      delivered = delivered_count
