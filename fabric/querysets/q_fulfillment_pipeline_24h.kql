// Pipeline counts across created → picked → shipped in last 24h
let window = 24h;
let created_count = toscalar(
    online_order_created
    | where ingest_timestamp > ago(window)
    | summarize count()
);
let picked_count = toscalar(
    online_order_picked
    | where ingest_timestamp > ago(window)
    | summarize count()
);
let shipped_count = toscalar(
    online_order_shipped
    | where ingest_timestamp > ago(window)
    | summarize count()
);
print created = created_count, picked = picked_count, shipped = shipped_count
