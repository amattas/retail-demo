table fact_logistics_incident_stores
	lineageTag: c2400000-0000-0000-0000-000000000001
	sourceLineageTag: [ag].[fact_logistics_incident_stores]

	/// Affected store-incident pairs in context.
	measure 'Incident Store Impacts' = COUNTROWS('fact_logistics_incident_stores')
		formatString: #,0
		displayFolder: Logistics\Incidents
		lineageTag: c2400002-0000-0000-0000-000000000001

	column 'Incident ID'
		dataType: string
		lineageTag: c2400001-0000-0000-0000-000000000001
		sourceLineageTag: incident_id
		summarizeBy: none
		sourceColumn: incident_id

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	/// A store the incident affects.
	column 'Store ID'
		dataType: int64
		formatString: 0
		lineageTag: c2400001-0000-0000-0000-000000000002
		sourceLineageTag: store_id
		summarizeBy: none
		sourceColumn: store_id

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	column 'DC ID'
		dataType: int64
		formatString: 0
		lineageTag: c2400001-0000-0000-0000-000000000003
		sourceLineageTag: dc_id
		summarizeBy: none
		sourceColumn: dc_id

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	column 'Incident Type'
		dataType: string
		lineageTag: c2400001-0000-0000-0000-000000000004
		sourceLineageTag: incident_type
		summarizeBy: none
		sourceColumn: incident_type

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	/// UTC start of the incident.
	column 'Started At'
		dataType: dateTime
		formatString: General Date
		lineageTag: c2400001-0000-0000-0000-000000000005
		sourceLineageTag: started_at
		summarizeBy: none
		sourceColumn: started_at

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	/// UTC resolution time; blank while the incident is open.
	column 'Resolved At'
		dataType: dateTime
		formatString: General Date
		lineageTag: c2400001-0000-0000-0000-000000000006
		sourceLineageTag: resolved_at
		summarizeBy: none
		sourceColumn: resolved_at

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	column 'Trace ID'
		dataType: string
		isHidden
		lineageTag: c2400001-0000-0000-0000-000000000007
		sourceLineageTag: trace_id
		summarizeBy: none
		sourceColumn: trace_id

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	/// UTC date the incident started.
	column 'Event Date'
		dataType: dateTime
		formatString: Short Date
		isHidden
		lineageTag: c2400001-0000-0000-0000-000000000008
		sourceLineageTag: event_date
		summarizeBy: none
		sourceColumn: event_date

		changedProperty = Name

		annotation SummarizationSetBy = Automatic

	partition fact_logistics_incident_stores = entity
		mode: directLake
		source
			entityName: fact_logistics_incident_stores
			schemaName: ag
			expressionSource: 'DirectLake - retail_lakehouse'

