table dim_trucks
	lineageTag: 7eb610bd-c508-404e-b04a-5cb53d07d17a
	sourceLineageTag: [ag].[dim_trucks]

	measure '# of Trucks' = COUNTROWS(dim_trucks)
		formatString: #,0
		lineageTag: 01a1a1b5-0001-0001-0001-000000000001

	/// Latest recorded truck-move event timestamp at or before UTC current time for one selected truck in the current source-grounded Store/DC filter context.
	measure 'Twin Truck State As Of' = ```
			VAR _SelectedTruckId =
				SELECTEDVALUE('dim_trucks'[ID])
			VAR _VisibleStoreIds =
				VALUES('dim_stores'[ID])
			VAR _VisibleDCIds =
				VALUES('dim_distribution_centers'[ID])
			VAR _ObservationCutoff =
				UTCNOW()
			VAR _LatestEventTs =
				IF(
					NOT ISBLANK(_SelectedTruckId),
					CALCULATE(
						MAX('fact_truck_moves'[Event Timestamp]),
						KEEPFILTERS(TREATAS(_VisibleStoreIds, 'fact_truck_moves'[Store ID])),
						KEEPFILTERS(TREATAS(_VisibleDCIds, 'fact_truck_moves'[DC ID])),
						KEEPFILTERS('fact_truck_moves'[Event Timestamp] <= _ObservationCutoff)
					)
				)
			RETURN
				_LatestEventTs
			```
		formatString: General Date
		displayFolder: Connected Twins\Truck
		lineageTag: c2200003-0000-0000-0000-000000000001

	/// Latest recorded truck status for one selected truck. Tied latest rows return BLANK rather than an arbitrary status.
	measure 'Twin Truck Last Status' = ```
			VAR _SelectedTruckId =
				SELECTEDVALUE('dim_trucks'[ID])
			VAR _AsOf =
				[Twin Truck State As Of]
			VAR _VisibleStoreIds =
				VALUES('dim_stores'[ID])
			VAR _VisibleDCIds =
				VALUES('dim_distribution_centers'[ID])
			VAR _LatestRows =
				CALCULATETABLE(
					SUMMARIZE(
						'fact_truck_moves',
						'fact_truck_moves'[Status],
						'fact_truck_moves'[Shipment ID],
						'fact_truck_moves'[Store ID],
						'fact_truck_moves'[DC ID],
						'fact_truck_moves'[Recorded ETA],
						'fact_truck_moves'[Recorded ETD]
					),
					KEEPFILTERS(TREATAS(_VisibleStoreIds, 'fact_truck_moves'[Store ID])),
					KEEPFILTERS(TREATAS(_VisibleDCIds, 'fact_truck_moves'[DC ID])),
					KEEPFILTERS('fact_truck_moves'[Event Timestamp] = _AsOf)
				)
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(_SelectedTruckId), BLANK(),
					ISBLANK(_AsOf), "not observed",
					COUNTROWS(_LatestRows) = 1, MAXX(_LatestRows, 'fact_truck_moves'[Status]),
					BLANK()
				)
			```
		displayFolder: Connected Twins\Truck
		lineageTag: c2200003-0000-0000-0000-000000000002

