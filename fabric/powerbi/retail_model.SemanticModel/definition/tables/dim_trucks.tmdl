					ISBLANK(_AsOf), BLANK(),
					COUNTROWS(_LatestRows) = 1, MAXX(_LatestRows, 'fact_truck_moves'[Shipment ID]),
					BLANK()
				)
			```
		displayFolder: Connected Twins\Truck
		lineageTag: c2200003-0000-0000-0000-000000000003

