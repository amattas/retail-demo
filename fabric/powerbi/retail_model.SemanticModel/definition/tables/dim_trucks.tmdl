	/// Recorded planned ETA from the single latest observed truck-move row for one selected truck; the ETA value may be future. Ties or no evidence return BLANK.
	measure 'Twin Truck Recorded ETA' = ```
			VAR _SelectedTruckId =
				SELECTEDVALUE('dim_trucks'[ID])
			VAR _AsOf =
				[Twin Truck State As Of]
			VAR _VisibleStoreIds =
				VALUES('dim_stores'[ID])
			VAR _VisibleDCIds =
				VALUES('dim_distribution_centers'[ID])
			VAR _LatestRows =
				CALCULATETABLE(
					SUMMARIZE(
						'fact_truck_moves',
						'fact_truck_moves'[Recorded ETA],
						'fact_truck_moves'[Status],
						'fact_truck_moves'[Shipment ID],
						'fact_truck_moves'[Store ID],
						'fact_truck_moves'[DC ID],
						'fact_truck_moves'[Recorded ETD]
					),
					KEEPFILTERS(TREATAS(_VisibleStoreIds, 'fact_truck_moves'[Store ID])),
					KEEPFILTERS(TREATAS(_VisibleDCIds, 'fact_truck_moves'[DC ID])),
					KEEPFILTERS('fact_truck_moves'[Event Timestamp] = _AsOf)
				)
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(_SelectedTruckId), BLANK(),
					ISBLANK(_AsOf), BLANK(),
					COUNTROWS(_LatestRows) = 1, MAXX(_LatestRows, 'fact_truck_moves'[Recorded ETA]),
					BLANK()
				)
			```
		formatString: General Date
		displayFolder: Connected Twins\Truck\Schedule
		lineageTag: c2200003-0000-0000-0000-000000000006

