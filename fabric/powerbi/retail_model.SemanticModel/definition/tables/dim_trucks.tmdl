	/// Observed cargo balance for the latest source-recorded truck/shipment pair at or before UTC current time: LOAD adds quantity and UNLOAD removes quantity. Product filters apply after shipment selection.
	measure 'Twin Truck Cargo Balance' = ```
			VAR _SelectedTruckId =
				SELECTEDVALUE('dim_trucks'[ID])
			VAR _LastShipment =
				[Twin Truck Last Shipment]
			VAR _ObservationCutoff =
				UTCNOW()
			VAR _CargoEvents =
				CALCULATETABLE(
					'fact_truck_inventory',
					KEEPFILTERS('fact_truck_inventory'[Truck ID] = _SelectedTruckId),
					KEEPFILTERS('fact_truck_inventory'[Shipment ID] = _LastShipment),
					KEEPFILTERS('fact_truck_inventory'[Event Timestamp] <= _ObservationCutoff)
				)
			VAR _CargoBalance =
				SUMX(
					_CargoEvents,
					SWITCH(
						TRUE(),
						'fact_truck_inventory'[Action] = "LOAD", 'fact_truck_inventory'[Quantity],
						'fact_truck_inventory'[Action] = "UNLOAD", -'fact_truck_inventory'[Quantity],
						BLANK()
					)
				)
			VAR _InvalidCargoRows =
				COUNTROWS(
					FILTER(
						_CargoEvents,
						ISBLANK('fact_truck_inventory'[Quantity])
							|| 'fact_truck_inventory'[Quantity] < 0
							|| NOT ('fact_truck_inventory'[Action] IN {"LOAD", "UNLOAD"})
					)
				)
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(_SelectedTruckId), BLANK(),
					ISBLANK(_LastShipment), BLANK(),
					ISEMPTY(_CargoEvents), BLANK(),
					_InvalidCargoRows > 0, BLANK(),
					_CargoBalance
				)
			```
		formatString: #,0
		displayFolder: Connected Twins\Truck\Cargo
		lineageTag: c2200003-0000-0000-0000-000000000008

	/// Latest observed cargo event timestamp at or before UTC current time for the latest source-recorded truck/shipment pair. Product filters preserve source evidence.
	measure 'Twin Truck Cargo As Of' = ```
			VAR _SelectedTruckId =
				SELECTEDVALUE('dim_trucks'[ID])
			VAR _LastShipment =
				[Twin Truck Last Shipment]
			VAR _ObservationCutoff =
				UTCNOW()
			VAR _CargoEvents =
				CALCULATETABLE(
					'fact_truck_inventory',
					KEEPFILTERS('fact_truck_inventory'[Truck ID] = _SelectedTruckId),
					KEEPFILTERS('fact_truck_inventory'[Shipment ID] = _LastShipment),
					KEEPFILTERS('fact_truck_inventory'[Event Timestamp] <= _ObservationCutoff)
				)
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(_SelectedTruckId), BLANK(),
					ISBLANK(_LastShipment), BLANK(),
					ISEMPTY(_CargoEvents), BLANK(),
					MAXX(_CargoEvents, 'fact_truck_inventory'[Event Timestamp])
				)
			```
		formatString: General Date
		displayFolder: Connected Twins\Truck\Cargo
		lineageTag: c2200003-0000-0000-0000-000000000009

	/// What-if ETA scenario equal to the recorded ETA plus 60 minutes; it never overwrites the actual recorded ETA.
	measure 'Twin Truck Delay Scenario ETA' = ```
			VAR _RecordedETA =
				[Twin Truck Recorded ETA]
			RETURN
				IF(
					ISBLANK(_RecordedETA),
					BLANK(),
					_RecordedETA + TIME(1, 0, 0)
				)
			```
		formatString: General Date
		displayFolder: Connected Twins\Truck\Delay Scenario
		lineageTag: c2200003-0000-0000-0000-00000000000a

	/// What-if delay minutes used by the delay scenario. Returns 60 only when a recorded ETA exists in source evidence.
	measure 'Twin Truck Delay Minutes' = ```
			VAR _RecordedETA =
				[Twin Truck Recorded ETA]
			RETURN
				IF(
					ISBLANK(_RecordedETA),
					BLANK(),
					60
				)
			```
		formatString: 0
		displayFolder: Connected Twins\Truck\Delay Scenario
		lineageTag: c2200003-0000-0000-0000-00000000000b

