table price_elasticity
	lineageTag: c5e6e000-0000-0000-0005-000000000000
	sourceLineageTag: [au].[price_elasticity]

	/// Distinct products with an estimated price-elasticity coefficient.
	measure 'Products Priced' = DISTINCTCOUNT('price_elasticity'[Product ID])
		formatString: #,0
		displayFolder: ML\Price Elasticity
		lineageTag: c5e6e000-0000-0000-0005-000000000101

	/// Mean price-elasticity coefficient across the in-context products.
	measure 'Avg Price Elasticity' = AVERAGE('price_elasticity'[Elasticity Coefficient])
		formatString: #,0.00
		displayFolder: ML\Price Elasticity
		lineageTag: c5e6e000-0000-0000-0005-000000000102

	/// Products whose demand is highly sensitive to price changes.
	measure 'Highly Elastic SKUs' = CALCULATE(DISTINCTCOUNT('price_elasticity'[Product ID]), 'price_elasticity'[Elasticity Category] = "Highly Elastic")
		formatString: #,0
		displayFolder: ML\Price Elasticity
		lineageTag: c5e6e000-0000-0000-0005-000000000103

	/// Products whose demand barely moves with price (pricing power).
	measure 'Inelastic SKUs' = CALCULATE(DISTINCTCOUNT('price_elasticity'[Product ID]), 'price_elasticity'[Elasticity Category] = "Inelastic")
		formatString: #,0
		displayFolder: ML\Price Elasticity
		lineageTag: c5e6e000-0000-0000-0005-000000000104

	column 'Product ID'
		dataType: int64
		formatString: 0
		lineageTag: c5e6e000-0000-0000-0005-000000000001
		sourceLineageTag: product_id
		summarizeBy: none
