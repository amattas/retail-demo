		annotation SummarizationSetBy = Automatic

	/// Date portion of the receipt event timestamp. Used for the dim_date relationship (Direct Lake requires matching column types, so this date column relates to dim_date[Date] instead of the timestamp).
	column 'Event Date'
		dataType: dateTime
		formatString: Short Date
		isHidden
		lineageTag: a1a1a1a1-0000-0000-0000-000000000011
		sourceLineageTag: event_date
		summarizeBy: none
		sourceColumn: event_date

		annotation SummarizationSetBy = Automatic

	/// Store-local hour (0-23) of the receipt. Event Timestamp is UTC; use this column for hour-of-day analysis.
	column 'Local Hour'
		dataType: int64
		formatString: 0
		lineageTag: a1a1a1a1-0000-0000-0000-000000000012
		sourceLineageTag: local_hour
		summarizeBy: none
		sourceColumn: local_hour

		annotation SummarizationSetBy = Automatic

	/// For a RETURN row, the receipt ID of the sale it refunds; blank on sales.
	column 'Original Receipt ID'
		dataType: string
		lineageTag: a1a1a1a1-0000-0000-0000-000000000013
		sourceLineageTag: original_receipt_id_ext
		summarizeBy: none
		sourceColumn: original_receipt_id_ext

		annotation SummarizationSetBy = Automatic

	partition fact_receipts = entity
		mode: directLake
		source
			entityName: fact_receipts
			schemaName: ag
			expressionSource: 'DirectLake - retail_lakehouse'
