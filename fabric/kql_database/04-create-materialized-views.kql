// 04 Materialized Views
// Purpose: Materialized views for hot KPIs (aligned to datagen payloads)
// Run this entire script at once using .execute database script
// ============================================================================
//
// ⚠️ IMPORTANT: 7-DAY DATA RETENTION
// ============================================================================
// All materialized views use a 7-day retention policy on their materialized
// data to prevent unbounded growth and ensure predictable storage usage.
// Materialized-view queries must remain deterministic and cannot use now()/ago().
//
// IMPLICATIONS:
// - Retention is based on MV extent creation time, not the event timestamp
// - Source-table retention remains independent from MV retention
// - For durable historical analysis, query Lakehouse history or retained sources
//
// ALTERNATIVES CONSIDERED:
// - Source-table-only retention: Does not independently bound MV materialization
// - Extended windows: Risk of memory/performance issues at scale
//
// For longer retention needs, consider:
// 1. Query base tables with explicit time filters
// 2. Export MV data to Lakehouse for historical aggregations
// 3. Create separate "archive" tables with scheduled exports
// ============================================================================

.execute database script with (ThrowOnErrors=true) <|

// ============================================================================
// SALES KPIs
// ============================================================================

.create-or-alter materialized-view mv_store_sales_minute on table receipt_created
{
    receipt_created
    | where isnotnull(store_id) and isnotnull(total)
    | summarize total_sales = sum(total), receipts = count(), avg_basket = avg(total)
              by store_id, ts = bin(ingest_timestamp, 1m)
}

.alter-merge materialized-view mv_store_sales_minute policy retention softdelete = 7d recoverability = disabled

.create-or-alter materialized-view mv_top_products_15m on table receipt_line_added
{
    receipt_line_added
    | where isnotnull(product_id) and isnotnull(extended_price)
    | summarize revenue = sum(extended_price), units = sum(quantity)
              by product_id, ts = bin(ingest_timestamp, 15m)
}

.alter-merge materialized-view mv_top_products_15m policy retention softdelete = 7d recoverability = disabled

.create-or-alter materialized-view mv_sales_product_minute on table receipt_line_added
{
    receipt_line_added
    | where isnotnull(product_id) and isnotnull(extended_price)
    | summarize revenue = sum(extended_price), units = sum(quantity)
              by product_id, ts = bin(ingest_timestamp, 1m)
}

.alter-merge materialized-view mv_sales_product_minute policy retention softdelete = 7d recoverability = disabled

// ============================================================================
// PAYMENT KPIs
// ============================================================================

.create-or-alter materialized-view mv_tender_mix_15m on table payment_processed
{
    payment_processed
    | where isnotnull(payment_method) and isnotnull(amount)
    | summarize amount = sum(amount) by payment_method, ts = bin(ingest_timestamp, 15m)
}

.alter-merge materialized-view mv_tender_mix_15m policy retention softdelete = 7d recoverability = disabled

// ============================================================================
// CUSTOMER KPIs
// ============================================================================

.create-or-alter materialized-view mv_zone_dwell_minute on table customer_entered
{
    customer_entered
    | where isnotnull(store_id) and isnotnull(zone)
    | summarize avg_dwell = avg(dwell_time), customers = sum(customer_count)
              by store_id, zone, ts = bin(ingest_timestamp, 1m)
}

.alter-merge materialized-view mv_zone_dwell_minute policy retention softdelete = 7d recoverability = disabled
