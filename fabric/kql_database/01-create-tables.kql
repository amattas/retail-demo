// LOGISTICS INCIDENTS (incidents.INCIDENT_TYPES: DC_OUTAGE, LANE_DELAY, WEATHER,
// HOLIDAY_CAPACITY, SUPPLIER_SHORT_SHIP). Started and resolved events share
// incident_id; affected_store_ids lists every store the incident affects (the
// DC's stores, the lane's store, or the geography's stores).

.create-merge table logistics_incident_started (
    incident_id:string,
    incident_type:string,
    dc_id:long,
    store_id:long,
    started_at:datetime,
    severity:string,
    affected_store_count:long,
    description:string,
    affected_store_ids:dynamic,
    event_type:string,
    trace_id:string,
    ingest_timestamp:datetime,
    schema_version:string,
    source:string,
    correlation_id:string,
    partition_key:string,
    session_id:string,
    parent_event_id:string
)

// Restate the full schema so Eventhouses created before affected_store_ids take
// the declared (positional) order; existing columns keep their types.
.alter table logistics_incident_started (
    incident_id:string,
    incident_type:string,
    dc_id:long,
    store_id:long,
    started_at:datetime,
    severity:string,
    affected_store_count:long,
