// MARKETING EVENTS

// impression_time is when the impression was shown. Marketing journey touches
// arrive with their purchase (ingest_timestamp) but were shown up to 7 days
// earlier; background impressions have impression_time == ingest_timestamp.
.create-merge table ad_impression (
    channel:string,
    campaign_id:string,
    creative_id:string,
    customer_ad_id:string,
    impression_id:string,
    cost:real,
    device_type:string,
