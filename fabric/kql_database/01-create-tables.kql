// .create-merge appends new columns to an existing table, but the stream writes
// columns by position. Restate the full schema so existing Eventhouses take the
// declared order (planned_arrival_time, delay_minutes, delay_reason and
// load_units before the envelope). Every existing column keeps its type, so no
// data is dropped.
.alter table truck_arrived (
    truck_id:string,
    dc_id:long,
    store_id:long,
    shipment_id:string,
    arrival_time:datetime,
    estimated_unload_duration:long,
